# Copie para .env (ou defina no terminal) e ajuste.

# Segredo do token JWT (RNF-004). Use um valor longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo

# Porta do servidor
PORT=3000

# Supabase: com as duas variáveis abaixo, o app usa o banco do Supabase.
# Sem elas, usa memória + arquivo local data/coado.json.
# Crie as tabelas antes rodando supabase/schema.sql no SQL Editor.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=chave-service-role (nunca coloque no front-end)

# Só memória (os dados somem ao reiniciar):
# COADO_DADOS=:memoria:
